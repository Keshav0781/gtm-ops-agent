# ============================================
# GTM OPS AGENT — ENVIRONMENT CONFIGURATION
# ============================================

# LLM Provider — Primary (Cloud, Fast)
# Get free API key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider — Secondary (Local, GDPR Compliant)
# Install Ollama from ollama.ai — completely free
# No API key needed — runs on your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM Routing — which data goes where
# Options: groq, ollama
DEFAULT_LLM_PROVIDER=groq

# LangSmith Monitoring
# Get free API key from smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=gtm-ops-agent

# Database
# Get free project from supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# n8n
# Runs locally via Docker
N8N_WEBHOOK_URL=http://localhost:5678

# Slack Bot Token
# Get from api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Database URL
# For local: postgresql://gtmuser:gtmpassword@localhost:5432/gtmops
# For Railway: provided automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname